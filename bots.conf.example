# bots.conf — список магазинов (ботов-мини-аппов) для update-all.sh
#
# Одно имя на строку. Имя = папка магазина в /opt/shops и имя systemd-сервиса
# tg-shop@<имя>. Строки с '#' и пустые строки игнорируются.
#
# Если этого файла нет, update-all.sh обновляет ВСЕ магазины из /opt/shops,
# у которых есть .env.
#
# Необязательная строка branch=<имя> задаёт ветку git, из которой тянется код
# (то же, что UPDATE_BRANCH=... в окружении; окружение имеет приоритет).
# Если ветка существует только локально и её нет в origin — скрипт не падает,
# а пропускает pull и раскатывает локальный код (урок инцидента с веткой pr-1).

# branch=fix/ux-bugs-and-update-script

# Примеры (раскомментируйте и впишите свои магазины):
# vinty
# merch
# gadgets
